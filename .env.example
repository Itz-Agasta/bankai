# Copy to .env (gitignored) or ~/.config/bankai/env (chmod 600).
GEMINI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=

# Optional model overrides. Leave empty to use the defaults in packages/core.
BANKAI_VISION_MODEL=
BANKAI_CHECKER_MODEL=
BANKAI_VISION_FALLBACK_MODEL=

# Cache of model answers; BANKAI_REPLAY=1 answers only from it (no API calls).
BANKAI_CACHE_DIR=
BANKAI_REPLAY=
