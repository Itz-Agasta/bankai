{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "ignoreDependencies": ["oxfmt", "oxlint"]
    },
    "apps/*": {
      "entry": ["src/main.ts", "src/index.ts", "test/**/*.test.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "packages/*": {
      "entry": ["scripts/*.ts", "test/**/*.test.ts"],
      "project": ["src/**/*.ts", "scripts/**/*.ts", "test/**/*.ts"]
    }
  }
}
